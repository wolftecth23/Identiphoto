{%- liquid
  assign heading = 'b2b_registration.title' | t
  if block.settings.heading != blank
    assign heading = block.settings.heading
  endif
  assign description = 'b2b_registration.description' | t
  if block.settings.description != blank
    assign description = block.settings.description
  endif
  assign field_id = 'b2b-register-' | append: block.id
-%}

{% render 'b2b-registration-styles' %}

<div class="b2b-register" {{ block.shopify_attributes }}>
  <div class="b2b-register__header">
    <h2 class="b2b-register__title">{{ heading | escape }}</h2>
    {%- unless customer.b2b? -%}
      <p class="b2b-register__description">{{ description | escape }}</p>
      {%- unless customer -%}
        <p class="b2b-register__sign-in">
          {{ 'b2b_registration.sign_in_prompt' | t }}
          <a href="{{ routes.account_login_url }}">{{ 'b2b_registration.sign_in' | t }}</a>
        </p>
      {%- endunless -%}
    {%- endunless -%}
  </div>

  {%- if customer.b2b? -%}
    {%- liquid
      assign company_name = customer.current_company.name
      if company_name == blank
        assign company_name = customer.company_available_locations.first.company.name
      endif
    -%}
    <h3 class="b2b-register__subheading">{{ 'b2b_registration.business_account_title' | t }}</h3>
    <dl class="b2b-register__summary">
      <div class="b2b-register__summary-row">
        <dt>{{ 'b2b_registration.fields.company' | t }}</dt>
        <dd>{{ company_name | escape }}</dd>
      </div>
      <div class="b2b-register__summary-row">
        <dt>{{ 'b2b_registration.status' | t }}</dt>
        <dd><span class="b2b-register__badge">{{ 'b2b_registration.active' | t }}</span></dd>
      </div>
    </dl>
  {%- else -%}
    <div
      data-b2b-register
      data-submit-url="/apps/b2b-register/link"
      data-regions-url="/apps/b2b-register/regions"
      data-phone-url="/apps/b2b-register/phone"
      data-country="{{ customer.default_address.country_code | default: localization.country.iso_code | escape }}"
      data-province="{{ customer.default_address.province_code | escape }}"
      data-city="{{ customer.default_address.city | escape }}"
    >
      <script type="application/json" data-b2b-register-messages>
        {
          "submitError": {{ 'b2b_registration.messages.submit_error' | t | json }},
          "addressLoadError": {{ 'b2b_registration.messages.address_load_error' | t | json }},
          "countryPlaceholder": {{ 'b2b_registration.fields.country_placeholder' | t | json }},
          "statePlaceholder": {{ 'b2b_registration.fields.state_placeholder' | t | json }},
          "cityPlaceholder": {{ 'b2b_registration.fields.city_placeholder' | t | json }},
          "success": {{ 'b2b_registration.messages.success' | t | json }},
          "successJoinedCompany": {{ 'b2b_registration.messages.success_joined_company' | t | json }},
          "validation": {
            "required": {{ 'b2b_registration.validation.required' | t | json }},
            "email": {{ 'b2b_registration.validation.email' | t | json }},
            "firstName": {{ 'b2b_registration.validation.first_name' | t | json }},
            "lastName": {{ 'b2b_registration.validation.last_name' | t | json }},
            "companyName": {{ 'b2b_registration.validation.company_name' | t | json }},
            "address": {{ 'b2b_registration.validation.address' | t | json }},
            "city": {{ 'b2b_registration.validation.city' | t | json }},
            "postalCode": {{ 'b2b_registration.validation.postal_code' | t | json }},
            "phone": {{ 'b2b_registration.validation.phone' | t | json }},
            "zip": {{ 'b2b_registration.validation.zip' | t | json }},
            "postalCodeCa": {{ 'b2b_registration.validation.postal_code_ca' | t | json }}
          }
        }
      </script>

      <div class="b2b-register__banner" role="alert" data-b2b-register-banner hidden></div>

      <form class="b2b-register__form" data-b2b-register-form novalidate>
        <fieldset class="b2b-register__section">
          <legend class="b2b-register__legend">{{ 'b2b_registration.sections.personal' | t }}</legend>
          <div class="b2b-register__grid">
            <div class="b2b-register__field">
              <label for="{{ field_id }}-first-name">{{ 'b2b_registration.fields.first_name' | t }}</label>
              <input id="{{ field_id }}-first-name" name="firstName" type="text" autocomplete="given-name" maxlength="100" value="{{ customer.first_name | escape }}" required>
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-last-name">{{ 'b2b_registration.fields.last_name' | t }}</label>
              <input id="{{ field_id }}-last-name" name="lastName" type="text" autocomplete="family-name" maxlength="100" value="{{ customer.last_name | escape }}" required>
            </div>
            {%- unless customer -%}
              <div class="b2b-register__field b2b-register__field--full">
                <label for="{{ field_id }}-email">{{ 'b2b_registration.fields.email' | t }}</label>
                <input id="{{ field_id }}-email" name="email" type="email" autocomplete="email" maxlength="254" required>
              </div>
            {%- endunless -%}
          </div>
        </fieldset>

        <fieldset class="b2b-register__section">
          <legend class="b2b-register__legend">{{ 'b2b_registration.sections.company' | t }}</legend>
          <div class="b2b-register__grid">
            <div class="b2b-register__field b2b-register__field--full">
              <label for="{{ field_id }}-company">{{ 'b2b_registration.fields.company' | t }}</label>
              <input id="{{ field_id }}-company" name="companyName" type="text" autocomplete="organization" maxlength="255" required>
            </div>
            <div class="b2b-register__field b2b-register__field--full">
              <label for="{{ field_id }}-phone">{{ 'b2b_registration.fields.phone' | t }}</label>
              <div class="b2b-register__phone">
                <div class="b2b-register__phone-prefix">
                  <span aria-hidden="true" data-b2b-register-phone-prefix>US +1</span>
                  <select name="phoneCountry" aria-label="{{ 'b2b_registration.fields.phone_country' | t }}" data-b2b-register-phone-country>
                    <option value="US">United States (+1)</option>
                  </select>
                </div>
                <input id="{{ field_id }}-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" maxlength="30" required>
              </div>
            </div>
          </div>
        </fieldset>

        <fieldset class="b2b-register__section">
          <legend class="b2b-register__legend">{{ 'b2b_registration.sections.address' | t }}</legend>
          <div class="b2b-register__grid">
            <div class="b2b-register__field b2b-register__field--full">
              <label for="{{ field_id }}-address1">{{ 'b2b_registration.fields.street_address' | t }}</label>
              <input id="{{ field_id }}-address1" name="address1" type="text" autocomplete="address-line1" maxlength="255" required>
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-address2">{{ 'b2b_registration.fields.address_line_2' | t }}</label>
              <input id="{{ field_id }}-address2" name="address2" type="text" autocomplete="address-line2" maxlength="120">
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-address3">{{ 'b2b_registration.fields.address_line_3' | t }}</label>
              <input id="{{ field_id }}-address3" name="address3" type="text" autocomplete="address-line3" maxlength="120">
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-country">{{ 'b2b_registration.fields.country' | t }}</label>
              <select id="{{ field_id }}-country" name="countryCode" autocomplete="country" required>
                <option value="">{{ 'b2b_registration.fields.loading' | t }}</option>
              </select>
            </div>
            <div class="b2b-register__field" data-b2b-register-region>
              <label for="{{ field_id }}-province">{{ 'b2b_registration.fields.state_province' | t }}</label>
              <select id="{{ field_id }}-province" name="provinceCode" autocomplete="address-level1" required>
                <option value="">{{ 'b2b_registration.fields.state_placeholder' | t }}</option>
              </select>
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-city">{{ 'b2b_registration.fields.city' | t }}</label>
              <select id="{{ field_id }}-city" name="city" required data-b2b-register-city-select>
                <option value="">{{ 'b2b_registration.fields.city_placeholder' | t }}</option>
              </select>
              <input id="{{ field_id }}-city-text" name="city" type="text" autocomplete="address-level2" maxlength="255" aria-label="{{ 'b2b_registration.fields.city' | t }}" required disabled hidden data-b2b-register-city-text>
            </div>
            <div class="b2b-register__field">
              <label for="{{ field_id }}-zip">{{ 'b2b_registration.fields.zip' | t }}</label>
              <input id="{{ field_id }}-zip" name="zip" type="text" autocomplete="postal-code" maxlength="10" required>
            </div>
          </div>
        </fieldset>

        <div class="b2b-register__actions">
          <button type="submit" class="button button--primary b2b-register__submit">
            {{ 'b2b_registration.submit' | t }}
          </button>
        </div>
      </form>

      <div data-b2b-register-success hidden>
        <h3 class="b2b-register__subheading">{{ 'b2b_registration.business_account_title' | t }}</h3>
        <dl class="b2b-register__summary">
          <div class="b2b-register__summary-row">
            <dt>{{ 'b2b_registration.fields.company' | t }}</dt>
            <dd data-b2b-register-company></dd>
          </div>
          <div class="b2b-register__summary-row">
            <dt>{{ 'b2b_registration.status' | t }}</dt>
            <dd><span class="b2b-register__badge">{{ 'b2b_registration.active' | t }}</span></dd>
          </div>
        </dl>
        {%- unless customer -%}
          <p class="b2b-register__after-register">
            {{ 'b2b_registration.messages.sign_in_after_register' | t }}
            <a href="{{ routes.account_login_url }}">{{ 'b2b_registration.sign_in' | t }}</a>
          </p>
        {%- endunless -%}
      </div>
    </div>

    {% render 'b2b-registration-script' %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.b2b_registration.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.b2b_registration.settings.heading.label",
      "info": "t:blocks.b2b_registration.settings.heading.info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:blocks.b2b_registration.settings.description.label",
      "info": "t:blocks.b2b_registration.settings.description.info"
    }
  ]
}
{% endschema %}
