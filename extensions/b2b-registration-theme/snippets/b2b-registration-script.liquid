{% doc %}
  Address fields, city suggestions, ZIP lookup and submit handler for the
  B2B registration block.
  Inlined so it runs even when the theme doesn't load app block assets.

  @example
  {% render 'b2b-registration-script' %}
{% enddoc %}
<script>
  (function () {
    function init(root) {
      if (root.dataset.b2bRegisterReady) return;
      root.dataset.b2bRegisterReady = "true";

      var form = root.querySelector("[data-b2b-register-form]");
      var banner = root.querySelector("[data-b2b-register-banner]");
      var success = root.querySelector("[data-b2b-register-success]");
      var button = form.querySelector('button[type="submit"]');
      // The `t` filter HTML-escapes ("couldn&#39;t"), but messages are shown
      // as text, so they're decoded once here. A textarea never runs markup.
      var decoder = document.createElement("textarea");
      var messages = JSON.parse(
        root.querySelector("[data-b2b-register-messages]").textContent,
        function (key, value) {
          if (typeof value !== "string") return value;
          decoder.innerHTML = value;
          return decoder.value;
        }
      );

      var country = form.elements.namedItem("countryCode");
      var region = form.elements.namedItem("provinceCode");
      var regionField = root.querySelector("[data-b2b-register-region]");
      var city = root.querySelector("[data-b2b-register-city]");
      var suggestionBox = root.querySelector("[data-b2b-register-suggestions]");
      var suggestionList = suggestionBox.querySelector('[role="listbox"]');
      var zip = form.elements.namedItem("zip");
      var phoneExt = form.elements.namedItem("phoneExt");
      var startedAt = Date.now();
      var phoneCountry = root.querySelector("[data-b2b-register-phone-country]");
      var phonePrefix = root.querySelector("[data-b2b-register-phone-prefix]");
      var phone = form.elements.namedItem("phone");
      var countries = [];

      function phoneCountryEntry() {
        return (
          countries.filter(function (entry) {
            return entry.code === phoneCountry.value;
          })[0] || { code: "US", phoneCode: "1" }
        );
      }

      function showDialCode() {
        phonePrefix.textContent =
          phoneCountry.value + " +" + phoneCountryEntry().phoneCode;
      }

      // The server checks the number against the dial-code country's
      // numbering plan. The last answer is kept with the input it was for, so
      // fieldError can use it until the number or dial code changes.
      var phoneCheck = { key: "", valid: true };

      function phoneKey() {
        return phoneCountry.value + "|" + phone.value.trim();
      }

      function checkPhone() {
        var key = phoneKey();
        if (phoneCheck.key === key) return Promise.resolve(phoneCheck);
        return fetch(root.dataset.phoneUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            number: phone.value.trim(),
            country: phoneCountry.value,
          }),
          credentials: "same-origin",
        })
          .then(function (response) {
            if (!response.ok) throw new Error("HTTP " + response.status);
            return response.json();
          })
          .then(function (result) {
            result.key = key;
            return result;
          });
      }

      // A number typed as +<code>… (often by autofill) moves the dial code to
      // the country it belongs to; valid numbers are shown in that country's
      // usual format.
      function applyPhoneCheck(result) {
        if (result.key !== phoneKey()) return;
        if (result.valid) {
          if (result.countryCode !== phoneCountry.value) {
            phoneCountry.value = result.countryCode;
            phoneCountryChosen = true;
            showDialCode();
          }
          phone.value = result.national;
          result.key = phoneKey();
        }
        phoneCheck = result;
      }

      // Runs when the customer leaves the field (to format the number) and on
      // submit; messages only change on submit.
      function verifyPhone() {
        if (!phone.value.trim() || fieldError(phone)) return Promise.resolve();
        // If the check can't run, the submit endpoint still validates.
        return checkPhone().then(applyPhoneCheck, function (error) {
          console.error(error);
        });
      }

      // Responses are cached by the browser and here, so switching back to a
      // country doesn't refetch it.
      var responses = {};
      function loadOptions(params) {
        var url = root.dataset.regionsUrl + "?" + new URLSearchParams(params);
        if (!responses[url]) {
          responses[url] = fetch(url, { headers: { Accept: "application/json" } })
            .then(function (response) {
              if (!response.ok) throw new Error("HTTP " + response.status);
              return response.json();
            })
            .catch(function (error) {
              delete responses[url];
              throw error;
            });
        }
        return responses[url];
      }

      function fillSelect(select, options, placeholder, selected) {
        select.replaceChildren(new Option(placeholder, ""));
        options.forEach(function (option) {
          select.add(new Option(option.label, option.value));
        });
        select.value = selected || "";
        if (select.selectedIndex < 0) select.value = "";
      }

      // City is typed; the dataset's cities for the chosen state are only
      // suggestions, since it misses many towns and suburbs.
      var cityNames = [];
      var activeSuggestion = -1;

      function closeSuggestions() {
        suggestionBox.hidden = true;
        city.setAttribute("aria-expanded", "false");
        city.removeAttribute("aria-activedescendant");
        activeSuggestion = -1;
      }

      // Names starting with what was typed come first, then ones containing it.
      function showSuggestions() {
        var query = city.value.trim().toLowerCase();
        if (!query || !cityNames.length) return closeSuggestions();
        var starts = [];
        var contains = [];
        cityNames.forEach(function (name) {
          var position = name.toLowerCase().indexOf(query);
          if (name.toLowerCase() === query) return;
          if (position === 0) starts.push(name);
          else if (position > 0) contains.push(name);
        });
        var matches = starts.concat(contains).slice(0, 8);
        if (!matches.length) return closeSuggestions();

        suggestionList.replaceChildren();
        matches.forEach(function (name, index) {
          var option = document.createElement("li");
          option.id = city.id + "-option-" + index;
          option.setAttribute("role", "option");
          option.setAttribute("aria-selected", "false");
          option.textContent = name;
          // mousedown, not click: it runs before the input's blur closes the list.
          option.addEventListener("mousedown", function (event) {
            event.preventDefault();
            chooseCity(name);
          });
          suggestionList.appendChild(option);
        });
        activeSuggestion = -1;
        suggestionBox.hidden = false;
        city.setAttribute("aria-expanded", "true");
      }

      function chooseCity(name) {
        city.value = name;
        cityFilledByZip = false;
        closeSuggestions();
      }

      function highlightSuggestion(index) {
        var options = suggestionList.children;
        if (!options.length) return;
        activeSuggestion = (index + options.length) % options.length;
        Array.prototype.forEach.call(options, function (option, i) {
          option.setAttribute("aria-selected", String(i === activeSuggestion));
        });
        city.setAttribute("aria-activedescendant", options[activeSuggestion].id);
        options[activeSuggestion].scrollIntoView({ block: "nearest" });
      }

      // True while the city holds what the ZIP lookup filled in, so a later
      // ZIP can replace it but never something the customer typed.
      var cityFilledByZip = false;

      city.addEventListener("input", function () {
        cityFilledByZip = false;
        showSuggestions();
      });
      city.addEventListener("keydown", function (event) {
        if (suggestionBox.hidden) {
          if (event.key === "ArrowDown") showSuggestions();
          return;
        }
        if (event.key === "ArrowDown") {
          event.preventDefault();
          highlightSuggestion(activeSuggestion + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          highlightSuggestion(activeSuggestion - 1);
        } else if (event.key === "Enter" && activeSuggestion >= 0) {
          event.preventDefault();
          chooseCity(suggestionList.children[activeSuggestion].textContent);
        } else if (event.key === "Escape") {
          closeSuggestions();
        }
      });
      city.addEventListener("blur", closeSuggestions);
      root
        .querySelector("[data-b2b-register-suggestions-close]")
        .addEventListener("mousedown", function (event) {
          event.preventDefault();
          closeSuggestions();
        });

      // Disabled fields are skipped by validation and left out of the
      // submission, so only a field that doesn't apply is disabled.
      function showRegions(applies) {
        regionField.hidden = !applies;
        region.disabled = !applies;
      }

      // Each change bumps the token so a slow response for an earlier choice
      // can't overwrite the lists for the current one.
      var loadToken = 0;

      function loadCities() {
        var token = ++loadToken;
        cityNames = [];
        if (!region.value) return Promise.resolve();
        return loadOptions({ country: country.value, region: region.value }).then(
          function (result) {
            if (token === loadToken) cityNames = result.cities;
          }
        );
      }

      function loadRegions(selectedRegion) {
        var token = ++loadToken;
        fillSelect(region, [], messages.statePlaceholder, "");
        showRegions(true);
        cityNames = [];
        if (!country.value) return Promise.resolve();
        return loadOptions({ country: country.value }).then(function (result) {
          if (token !== loadToken) return;
          showRegions(result.regions.length > 0);
          fillSelect(
            region,
            result.regions.map(function (entry) {
              return { value: entry.code, label: entry.name };
            }),
            messages.statePlaceholder,
            selectedRegion
          );
          if (result.regions.length) return loadCities();
          cityNames = result.cities;
        });
      }

      // A complete US ZIP or Canadian postal code fills in the state and
      // city (the city only if the customer hasn't typed one).
      var postalToken = 0;
      function fillFromPostalCode() {
        if (!root.dataset.postalUrl) return;
        if (country.value !== "US" && country.value !== "CA") return;
        if (!zip.value.trim() || fieldError(zip)) return;
        var token = ++postalToken;
        var url =
          root.dataset.postalUrl +
          "?" +
          new URLSearchParams({ country: country.value, zip: zip.value.trim() });
        fetch(url, { headers: { Accept: "application/json" } })
          .then(function (response) {
            if (!response.ok) throw new Error("HTTP " + response.status);
            return response.json();
          })
          .then(function (result) {
            if (token !== postalToken || !result.city) return;
            var regionChanged =
              result.provinceCode && region.value !== result.provinceCode;
            if (regionChanged) {
              region.value = result.provinceCode;
              if (region.value !== result.provinceCode) return;
              loadCities().catch(addressLoadFailed);
            }
            if (regionChanged || cityFilledByZip || !city.value.trim()) {
              city.value = result.city;
              cityFilledByZip = true;
            }
          })
          .catch(function (error) {
            // The customer can still type the city and pick the state.
            console.error(error);
          });
      }
      zip.addEventListener("change", fillFromPostalCode);

      function addressLoadFailed(error) {
        console.error(error);
        showBanner("critical", messages.addressLoadError);
      }

      // The dial code follows the address country until the customer picks
      // one themselves (e.g. a US company with a Canadian phone number).
      var phoneCountryChosen = false;

      country.addEventListener("change", function () {
        loadRegions("").catch(addressLoadFailed);
        if (!phoneCountryChosen && country.value) {
          phoneCountry.value = country.value;
          showDialCode();
          verifyPhone();
        }
      });
      phoneCountry.addEventListener("change", function () {
        phoneCountryChosen = true;
        showDialCode();
        verifyPhone();
      });
      region.addEventListener("change", function () {
        loadCities().catch(addressLoadFailed);
      });

      // Extensions are digits only.
      phoneExt.addEventListener("input", function () {
        var digits = phoneExt.value.replace(/\D/g, "");
        if (digits !== phoneExt.value) phoneExt.value = digits;
      });

      // Preselect the signed-in customer's default address, or the
      // storefront's country for guests.
      loadOptions({})
        .then(function (result) {
          countries = result.countries;
          fillSelect(
            country,
            countries.map(function (entry) {
              return { value: entry.code, label: entry.name };
            }),
            messages.countryPlaceholder,
            root.dataset.country
          );
          fillSelect(
            phoneCountry,
            countries
              .filter(function (entry) {
                return entry.phoneCode;
              })
              .map(function (entry) {
                return {
                  value: entry.code,
                  label: entry.name + " (+" + entry.phoneCode + ")",
                };
              }),
            messages.countryPlaceholder,
            country.value || "US"
          );
          // Drop the placeholder: there is always a dial code.
          phoneCountry.remove(0);
          showDialCode();
          if (root.dataset.city) city.value = root.dataset.city;
          return loadRegions(root.dataset.province);
        })
        .catch(addressLoadFailed);

      // The form is novalidate, so required fields get inline messages
      // instead of the browser's tooltips. Messages are only updated on
      // submit, so they stay put while the customer fixes a field. The state
      // field is disabled only while it doesn't apply, so a disabled one is
      // skipped when validating rather than left out here.
      var fields = Array.prototype.filter.call(form.elements, function (el) {
        return el.required;
      });

      // Errors the submit endpoint returned, kept until that field changes.
      var serverErrors = {};

      // Names in any script: letters, spaces, apostrophes, periods, hyphens.
      var namePattern = /^[\p{L}\p{M}][\p{L}\p{M}\s'’.\-]*$/u;

      function fieldError(el) {
        if (el.disabled) return "";
        var value = el.value.trim();
        var serverError = serverErrors[el.name];
        if (serverError && serverError.value === value) return serverError.message;
        if (!value) {
          var label =
            form.querySelector('label[for="' + el.id + '"]') ||
            el.closest(".b2b-register__field").querySelector("label");
          return messages.validation.required.replace(
            "%field%",
            label ? label.textContent.trim() : el.name
          );
        }
        if (el.name === "firstName" && !namePattern.test(value)) {
          return messages.validation.firstName;
        }
        if (el.name === "lastName" && !namePattern.test(value)) {
          return messages.validation.lastName;
        }
        if (
          el.type === "email" &&
          (el.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value))
        ) {
          return messages.validation.email;
        }
        if (
          el.name === "companyName" &&
          (value.match(/[\p{L}\p{N}]/gu) || []).length < 2
        ) {
          return messages.validation.companyName;
        }
        if (
          el.name === "address1" &&
          (value.length < 3 || !/[\p{L}\p{N}]/u.test(value))
        ) {
          return messages.validation.address;
        }
        if (el.name === "city" && !/\p{L}/u.test(value)) {
          return messages.validation.city;
        }
        if (el.name === "phone") {
          // Quick checks here; the server's answer covers the country's
          // numbering plan once it arrives.
          var digitCount = value.replace(/\D/g, "").length;
          var invalidPhone =
            digitCount < 4 ||
            digitCount > 20 ||
            /[^\d\s().+\-]/.test(value.replace(/\s*(ext\.?|x)\s*\d+$/i, "")) ||
            (phoneCheck.key === phoneKey() && !phoneCheck.valid);
          if (invalidPhone) return messages.validation.phone;
        }
        if (el.name === "zip") {
          if (country.value === "US" && !/^\d{5}(-\d{4})?$/.test(value)) {
            return messages.validation.zip;
          }
          if (
            country.value === "CA" &&
            !/^[A-Za-z]\d[A-Za-z][ -]?\d[A-Za-z]\d$/.test(value)
          ) {
            return messages.validation.postalCodeCa;
          }
          if (
            country.value !== "US" &&
            country.value !== "CA" &&
            !/^[A-Za-z0-9][A-Za-z0-9 -]{1,9}$/.test(value)
          ) {
            return messages.validation.postalCode;
          }
        }
        return "";
      }

      function validateField(el) {
        var message = fieldError(el);
        var error = document.getElementById(el.id + "-error");
        error.textContent = message;
        error.hidden = !message;
        el.closest(".b2b-register__field").classList.toggle(
          "b2b-register__field--invalid",
          Boolean(message)
        );
        if (message) {
          el.setAttribute("aria-invalid", "true");
        } else {
          el.removeAttribute("aria-invalid");
        }
        return !message;
      }

      fields.forEach(function (el) {
        var error = document.createElement("p");
        error.className = "b2b-register__error";
        error.id = el.id + "-error";
        error.hidden = true;
        el.closest(".b2b-register__field").appendChild(error);
        el.setAttribute("aria-describedby", error.id);
      });

      phone.addEventListener("blur", verifyPhone);

      // CAPTCHA: Cloudflare Turnstile, when the app has its keys. It runs in
      // the background and only shows a checkbox when Cloudflare needs a
      // click. Tokens are single use, so the widget is reset after a submit.
      var captchaBox = root.querySelector("[data-b2b-register-captcha]");
      var captchaSlot = captchaBox.querySelector("[data-b2b-register-captcha-widget]");
      var captchaHint = captchaBox.querySelector("[data-b2b-register-captcha-hint]");
      var captchaSiteKey = "";
      var captchaWidget = null;
      var captchaVisible = false;
      var captchaToken = "";
      var captchaFailed = false;
      var captchaInteractive = false;
      var captchaWaiters = [];

      // Ends any submit waiting for a token: with one, or "" after an error.
      function finishCaptchaWait() {
        captchaWaiters.splice(0).forEach(function (done) {
          done();
        });
      }

      // The box takes up space while the checkbox or the hint shows.
      function updateCaptchaBox() {
        if (captchaInteractive || captchaVisible || !captchaHint.hidden) {
          captchaBox.dataset.interactive = "";
        } else {
          delete captchaBox.dataset.interactive;
        }
      }

      function showCaptchaHint(show) {
        captchaHint.hidden = !show;
        updateCaptchaBox();
        if (show) captchaBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      function loadTurnstile() {
        if (window.turnstile) return Promise.resolve(window.turnstile);
        return new Promise(function (resolve, reject) {
          var script =
            document.querySelector("script[data-b2b-turnstile]") ||
            document.createElement("script");
          script.addEventListener("load", function () {
            resolve(window.turnstile);
          });
          script.addEventListener("error", reject);
          if (!script.src) {
            script.src =
              "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
            script.async = true;
            script.dataset.b2bTurnstile = "";
            document.head.appendChild(script);
          }
        });
      }

      // Hidden until Cloudflare needs a click; `visible` shows the box
      // outright, for when a hidden one didn't come up in time.
      function renderCaptcha(visible) {
        if (captchaWidget !== null) window.turnstile.remove(captchaWidget);
        captchaToken = "";
        captchaFailed = false;
        captchaVisible = visible;
        updateCaptchaBox();
        captchaWidget = window.turnstile.render(captchaSlot, {
          sitekey: captchaSiteKey,
          // The server refuses tokens made for any other action.
          action: "b2b-register",
          appearance: visible ? "always" : "interaction-only",
          language: {{ request.locale.iso_code | json }},
          callback: function (token) {
            captchaToken = token || "";
            if (captchaToken) finishCaptchaWait();
          },
          "expired-callback": function () {
            captchaToken = "";
          },
          "error-callback": function (code) {
            // Codes: developers.cloudflare.com/turnstile/troubleshooting/client-side-errors/
            console.warn("B2B registration: Turnstile error", code);
            captchaToken = "";
            captchaFailed = true;
            finishCaptchaWait();
          },
          "before-interactive-callback": function () {
            captchaInteractive = true;
            updateCaptchaBox();
          },
          "after-interactive-callback": function () {
            captchaInteractive = false;
            updateCaptchaBox();
          },
        });
      }

      var captchaReady = fetch(root.dataset.captchaUrl, {
        headers: { Accept: "application/json" },
      })
        .then(function (response) {
          return response.ok ? response.json() : {};
        })
        .then(function (config) {
          if (!config.siteKey) return;
          captchaSiteKey = config.siteKey;
          return loadTurnstile().then(function () {
            renderCaptcha(false);
          });
        })
        .catch(function (error) {
          // Blocked or offline: the server says so if it needs a token.
          console.error("B2B registration: Turnstile did not load", error);
        });

      // The widget's token. A background check usually has one ready. If
      // not within a few seconds (or the check failed), the box is shown
      // with a hint and the submit carries on once it's ticked. "" without a
      // widget, after an error, or after 2 minutes; the server then asks
      // them to try again.
      async function waitForCaptcha() {
        await captchaReady;
        if (captchaWidget === null || captchaToken) return captchaToken;
        if (captchaFailed) renderCaptcha(true);
        return new Promise(function (resolve) {
          var hintTimer = setTimeout(function () {
            if (!captchaInteractive && !captchaVisible) renderCaptcha(true);
            showCaptchaHint(true);
          }, 3000);
          var giveUpTimer = setTimeout(done, 120000);
          function done() {
            clearTimeout(hintTimer);
            clearTimeout(giveUpTimer);
            showCaptchaHint(false);
            resolve(captchaToken);
          }
          captchaWaiters.push(done);
        });
      }

      function resetCaptcha() {
        if (captchaWidget === null || !window.turnstile) return;
        captchaToken = "";
        window.turnstile.reset(captchaWidget);
      }

      function showBanner(tone, message) {
        banner.dataset.tone = tone;
        banner.textContent = message;
        banner.hidden = false;
        banner.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      // While a request runs, the submit button shows a spinner and
      // "Creating account…", and the form can't be sent twice.
      var buttonLabel = button.textContent.trim();
      function setBusy(busy) {
        button.disabled = busy;
        if (busy) {
          button.setAttribute("aria-busy", "true");
          button.replaceChildren();
          var spinner = document.createElement("span");
          spinner.className = "b2b-register__spinner";
          spinner.setAttribute("aria-hidden", "true");
          button.append(spinner, document.createTextNode(messages.submitting));
        } else {
          button.removeAttribute("aria-busy");
          button.textContent = buttonLabel;
        }
        matchButtons.forEach(function (choiceButton) {
          choiceButton.disabled = busy;
        });
      }

      // An existing company matches the email domain or company name: the
      // customer decides whether to join it or register a new company.
      var matchPanel = root.querySelector("[data-b2b-register-match]");
      var matchText = matchPanel.querySelector("[data-b2b-register-match-text]");
      var matchButtons = Array.prototype.slice.call(
        matchPanel.querySelectorAll("[data-choice]")
      );
      var companyChoice = "";
      var matchKey = "";

      // The answer only applies to the company name and email it was given for.
      function currentMatchKey() {
        var email = form.elements.namedItem("email");
        return (
          form.elements.namedItem("companyName").value.trim().toLowerCase() +
          "|" +
          (email ? email.value.trim().toLowerCase() : "")
        );
      }

      function hideMatch() {
        matchPanel.hidden = true;
        companyChoice = "";
        button.hidden = false;
      }

      function showMatch(match) {
        var typedName = form.elements.namedItem("companyName").value.trim();
        var reason =
          match.reason === "email_domain"
            ? messages.matchDomain.replace("%domain%", match.emailDomain || "")
            : messages.matchName;
        matchText.textContent = reason.replace(/%companyName%/g, match.companyName);
        matchButtons.forEach(function (choiceButton) {
          var label =
            choiceButton.dataset.choice === "join"
              ? messages.matchJoin.replace("%companyName%", match.companyName)
              : messages.matchNew.replace("%companyName%", typedName);
          choiceButton.textContent = label;
        });
        matchKey = currentMatchKey();
        matchPanel.hidden = false;
        // The two choices replace the submit button until one is picked.
        button.hidden = true;
        matchPanel.scrollIntoView({ behavior: "smooth", block: "center" });
        matchButtons[0].focus();
      }

      ["companyName", "email"].forEach(function (name) {
        var el = form.elements.namedItem(name);
        if (!el) return;
        el.addEventListener("input", function () {
          if (!matchPanel.hidden && currentMatchKey() !== matchKey) hideMatch();
        });
      });

      matchButtons.forEach(function (choiceButton) {
        choiceButton.addEventListener("click", function () {
          companyChoice = choiceButton.dataset.choice;
          submit();
        });
      });

      async function submit() {
        banner.hidden = true;
        setBusy(true);
        var captchaUsed = false;
        try {
          await verifyPhone();

          var invalid = fields.filter(function (el) {
            return !validateField(el);
          });
          if (invalid.length) {
            invalid[0].focus();
            return;
          }

          var data = new FormData(form);
          var value = function (name) {
            return String(data.get(name) || "").trim();
          };
          var payload = {
            firstName: value("firstName"),
            lastName: value("lastName"),
            email: value("email"),
            companyName: value("companyName"),
            // The server turns this into E.164 using phoneCountryCode.
            phone: value("phone"),
            phoneExt: value("phoneExt"),
            address1: value("address1"),
            address2: [value("address2"), value("address3")]
              .filter(Boolean)
              .join(", "),
            city: value("city"),
            provinceCode: value("provinceCode"),
            countryCode: value("countryCode"),
            phoneCountryCode: phoneCountry.value,
            zip: value("zip"),
            locale: {{ request.locale.iso_code | json }},
            companyChoice: companyChoice,
            // Bot checks: the hidden field stays empty and people take a while.
            website: value("website"),
            elapsedMs: Date.now() - startedAt,
            turnstileToken: await waitForCaptcha(),
          };
          captchaUsed = Boolean(payload.turnstileToken);

          // Same-origin app proxy request: Shopify signs it and adds
          // logged_in_customer_id when the customer is signed in.
          var response = await fetch(root.dataset.submitUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
            credentials: "same-origin",
          });
          var result = null;
          try {
            result = await response.json();
          } catch (error) {
            result = null;
          }

          if (response.ok && result && result.ok) {
            // Lets the theme hide its "Create account" link on later pages
            // (see the hide-registration-link app embed).
            try {
              window.localStorage.setItem("b2bRegistered", String(Date.now()));
            } catch (error) {
              // Storage blocked: the link just stays visible.
            }
            form.hidden = true;
            success.querySelector("[data-b2b-register-company]").textContent =
              result.companyName || payload.companyName;
            success.hidden = false;
            showBanner(
              "success",
              result.created === false && result.companyName
                ? messages.successJoinedCompany.replace(
                    "%companyName%",
                    result.companyName
                  )
                : messages.success
            );
            return;
          }

          if (result && result.code === "COMPANY_MATCH" && result.match) {
            showMatch(result.match);
            return;
          }

          if (result && result.code === "CAPTCHA_FAILED") {
            showBanner("critical", messages.captchaError);
            return;
          }

          // Show a field's error under that field.
          var target =
            result &&
            fields.filter(function (el) {
              return el.name === result.field && !el.disabled;
            })[0];
          if (target) {
            if (target === phone) {
              phoneCheck = { key: phoneKey(), valid: false };
            } else {
              serverErrors[target.name] = {
                value: target.value.trim(),
                message: result.error,
              };
            }
            validateField(target);
            target.focus();
            return;
          }

          var details = (result && result.userErrors ? result.userErrors : []).map(
            function (entry) {
              return entry.message;
            }
          );
          showBanner(
            "critical",
            [(result && result.error) || messages.submitError]
              .concat(details)
              .join(" ")
          );
        } catch (error) {
          console.error(error);
          showBanner("critical", messages.submitError);
        } finally {
          // The token was spent; the next submit (after a fix, or a
          // join/new choice) needs a fresh one.
          if (captchaUsed) resetCaptcha();
          setBusy(false);
        }
      }

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        // A new submit (after editing) asks again if a company matches.
        hideMatch();
        submit();
      });
    }

    document.querySelectorAll("[data-b2b-register]").forEach(init);
  })();
</script>
