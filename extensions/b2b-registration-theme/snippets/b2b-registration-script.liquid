{% doc %}
  Submit handler for the B2B registration block. Inlined so it runs even when
  the theme doesn't load app block assets.

  @example
  {% render 'b2b-registration-script' %}
{% enddoc %}
<script>
  (function () {
    function init(root) {
      if (root.dataset.b2bRegisterReady) return;
      root.dataset.b2bRegisterReady = "true";

      var form = root.querySelector("[data-b2b-register-form]");
      var banner = root.querySelector("[data-b2b-register-banner]");
      var success = root.querySelector("[data-b2b-register-success]");
      var button = form.querySelector('button[type="submit"]');
      var messages = JSON.parse(
        root.querySelector("[data-b2b-register-messages]").textContent
      );

      // Preselect the state from the signed-in customer's default address.
      var province = form.elements.namedItem("provinceCode");
      if (root.dataset.province) province.value = root.dataset.province;

      // The field shows a fixed +1 prefix; drop a leading 1 if the customer
      // typed it anyway.
      function phoneDigitsOf(raw) {
        var digits = raw.replace(/\D/g, "");
        if (digits.length === 11 && digits.charAt(0) === "1") {
          digits = digits.slice(1);
        }
        return digits;
      }

      // The form is novalidate, so required fields get inline messages
      // instead of the browser's tooltips.
      var fields = Array.prototype.filter.call(form.elements, function (el) {
        return el.required && !el.disabled;
      });

      function fieldError(el) {
        var value = el.value.trim();
        if (!value) {
          var label = form.querySelector('label[for="' + el.id + '"]');
          return messages.validation.required.replace(
            "%field%",
            label ? label.textContent.trim() : el.name
          );
        }
        if (el.type === "email" && el.validity.typeMismatch) {
          return messages.validation.email;
        }
        if (el.name === "phone" && phoneDigitsOf(value).length !== 10) {
          return messages.validation.phone;
        }
        if (el.name === "zip" && !/^\d{5}(-\d{4})?$/.test(value)) {
          return messages.validation.zip;
        }
        return "";
      }

      function validateField(el) {
        var message = fieldError(el);
        var error = document.getElementById(el.id + "-error");
        error.textContent = message;
        error.hidden = !message;
        el.closest(".b2b-register__field").classList.toggle(
          "b2b-register__field--invalid",
          Boolean(message)
        );
        if (message) {
          el.setAttribute("aria-invalid", "true");
        } else {
          el.removeAttribute("aria-invalid");
        }
        return !message;
      }

      fields.forEach(function (el) {
        var error = document.createElement("p");
        error.className = "b2b-register__error";
        error.id = el.id + "-error";
        error.hidden = true;
        el.closest(".b2b-register__field").appendChild(error);
        el.setAttribute("aria-describedby", error.id);

        // Clear the message as soon as a flagged field is fixed, and check
        // formats once the customer leaves a field they filled in.
        el.addEventListener(el.tagName === "SELECT" ? "change" : "input", function () {
          if (el.getAttribute("aria-invalid") === "true") validateField(el);
        });
        el.addEventListener("blur", function () {
          if (el.value.trim()) validateField(el);
        });
      });

      function showBanner(tone, message) {
        banner.dataset.tone = tone;
        banner.textContent = message;
        banner.hidden = false;
        banner.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      form.addEventListener("submit", async function (event) {
        event.preventDefault();
        banner.hidden = true;

        var invalid = fields.filter(function (el) {
          return !validateField(el);
        });
        if (invalid.length) {
          invalid[0].focus();
          return;
        }

        var data = new FormData(form);
        var value = function (name) {
          return String(data.get(name) || "").trim();
        };
        // Send E.164 (+1XXXXXXXXXX).
        var phoneDigits = phoneDigitsOf(value("phone"));

        var payload = {
          firstName: value("firstName"),
          lastName: value("lastName"),
          email: value("email"),
          companyName: value("companyName"),
          phone: phoneDigits ? "+1" + phoneDigits : "",
          address1: value("address1"),
          address2: [value("address2"), value("address3")]
            .filter(Boolean)
            .join(", "),
          city: value("city"),
          provinceCode: value("provinceCode"),
          countryCode: "US",
          zip: value("zip"),
          remoteShoppingAssistance: data.has("remoteAssist"),
        };

        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        try {
          // Same-origin app proxy request: Shopify signs it and adds
          // logged_in_customer_id when the customer is signed in.
          var response = await fetch(root.dataset.submitUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
            credentials: "same-origin",
          });
          var result = null;
          try {
            result = await response.json();
          } catch (error) {
            result = null;
          }

          if (response.ok && result && result.ok) {
            form.hidden = true;
            success.querySelector("[data-b2b-register-company]").textContent =
              result.companyName || payload.companyName;
            success.hidden = false;
            showBanner(
              "success",
              result.created === false && result.companyName
                ? messages.successJoinedCompany.replace(
                    "%companyName%",
                    result.companyName
                  )
                : messages.success
            );
            return;
          }

          var details = (result && result.userErrors ? result.userErrors : []).map(
            function (entry) {
              return entry.message;
            }
          );
          showBanner(
            "critical",
            [(result && result.error) || messages.submitError]
              .concat(details)
              .join(" ")
          );
        } catch (error) {
          console.error(error);
          showBanner("critical", messages.submitError);
        } finally {
          button.disabled = false;
          button.removeAttribute("aria-busy");
        }
      });
    }

    document.querySelectorAll("[data-b2b-register]").forEach(init);
  })();
</script>
